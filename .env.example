# Copy to .env (project root) and fill in. Never commit real credentials.

# --- Database (Neon serverless Postgres) -------------------------------------------------
# Pooled connection string (host contains "-pooler"). Used by the running API.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection string. Used by Alembic migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.REGION.aws.neon.tech/neondb?sslmode=require
# Throwaway database for pytest (Neon branch or separate database). Must NOT be the main DB.
# Tests drop and recreate all app tables in this database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.REGION.aws.neon.tech/booking_test?sslmode=require

# --- Backend -----------------------------------------------------------------------------
# IANA timezone for week boundaries (weeks start Monday 00:00 local time).
BUSINESS_TIMEZONE=Australia/Sydney
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Source rating scale (Booking.com uses 1-10).
RATING_SCALE_MIN=1
RATING_SCALE_MAX=10

IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=50000

# Only "manual" is supported: Booking.com's Terms prohibit automated access (docs/COLLECTION.md).
COLLECTOR_ADAPTER=manual
COLLECTOR_TIMEOUT_SECONDS=15
COLLECTOR_MAX_RETRIES=3
COLLECTOR_BACKOFF_BASE_SECONDS=1
COLLECTOR_RATE_LIMIT_PER_MINUTE=10

API_MAX_PAGE_SIZE=100

# --- Frontend (Next.js) ------------------------------------------------------------------
# Leave empty to call same-origin /api/* (proxied to BACKEND_URL by next.config.ts in dev).
NEXT_PUBLIC_API_BASE_URL=
BACKEND_URL=http://127.0.0.1:8000
