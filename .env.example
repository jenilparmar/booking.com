# Copy to .env and adjust. Never commit real secrets.

# SQLAlchemy URL. Default (unset) is SQLite at data/reviews.db.
# DATABASE_URL=sqlite:///./data/reviews.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/reviews

# IANA timezone used for week boundaries (weeks start Monday 00:00 local time).
BUSINESS_TIMEZONE=Australia/Sydney

# Comma-separated list of allowed browser origins for the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Source rating scale (Booking.com uses 1-10).
RATING_SCALE_MIN=1
RATING_SCALE_MAX=10

# Import limits.
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=50000

# Collection. Only "manual" is supported: Booking.com's Terms prohibit automated access.
COLLECTOR_ADAPTER=manual
COLLECTOR_TIMEOUT_SECONDS=15
COLLECTOR_MAX_RETRIES=3
COLLECTOR_BACKOFF_BASE_SECONDS=1
COLLECTOR_RATE_LIMIT_PER_MINUTE=10

API_MAX_PAGE_SIZE=100

# Frontend (read by Vite). Leave empty to use the dev-server proxy.
VITE_API_BASE_URL=
